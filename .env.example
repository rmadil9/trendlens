# Root .env — read by docker compose for ${...} substitution in
# docker-compose.prod.yml. Copy to .env on the server.
#
# This file holds deployment topology only. Application secrets live in
# backend/.env, which is passed to the backend container via env_file and never
# enters an image layer.

# The domain nginx serves and certbot requests a certificate for. Must already
# resolve to this server's public IP before the first certbot run — the HTTP-01
# challenge works by Let's Encrypt fetching a file over HTTP from this name.
DOMAIN=trendlens.adil9.tech

# Where certbot sends expiry warnings. Use a real address you read.
CERTBOT_EMAIL=you@example.com
