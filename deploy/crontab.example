# TrendLens production crontab — install with:  crontab deploy/crontab.example
# (edit the paths first if the repo doesn't live at /home/deploy/trendlens)
#
# Cron runs with a near-empty environment and a PATH that usually excludes
# /usr/local/bin, which is where the docker CLI lives on most installs. Setting
# PATH here is not optional cargo-culting — without it these lines fail with
# "docker: command not found" and nothing else explains why.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
SHELL=/bin/bash

# Ingest at the top of the hour, embed five minutes later. The gap lets
# ingestion finish writing before the embed job reads the work queue.
0 * * * * /home/deploy/trendlens/deploy/cron/ingest.sh
5 * * * * /home/deploy/trendlens/deploy/cron/embed.sh

# Both scripts hold a flock, so a slow run is skipped rather than stacked.
# Both append to <repo>/logs/. Add logrotate if those grow — nothing prunes
# them today.
